{
  "env": [
    {
      "AI_WRANGLE_ROOT": "$HOUDINI_USER_PREF_DIR/packages/Houdini-Ai-Attribute-Wrangle"
    },
    {
      "PYTHONPATH": {
        "method": "prepend",
        "value": "$AI_WRANGLE_ROOT/python"
      }
    },
    {
      "PATH": {
        "method": "prepend",
        "value": "$AI_WRANGLE_ROOT/bin"
      }
    }
  ],
  "hpath": "$AI_WRANGLE_ROOT"
}
